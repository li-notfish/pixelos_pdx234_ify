+package com.android.internal.util;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Keeps the user maintained list of game packages, plus the per game notification
+ * preferences, in sync with {@link Settings.Secure}.
+ *
+ * <p>The lists are stored as comma separated package names so that they can be
+ * maintained from adb:
+ * <pre>
+ *   settings put secure game_mode_packages "com.foo,com.bar"
+ *   settings put secure game_mode_suppress_heads_up "com.foo"
+ *   settings put secure game_mode_mute "com.foo,com.bar"
+ * </pre>
+ */
+public class GameModeController {
+
+    private static final String TAG = "GameModeController";
+
+    private final Context mContext;
+    private final SettingsObserver mObserver;
+
+    // Settings may not be readable yet when a system service constructs us during boot,
+    // so the initial load is retried lazily instead of throwing.
+    private volatile boolean mLoaded;
+
+    private Set<String> mGames = new HashSet<>();
+    private Set<String> mSuppressHeadsUp = new HashSet<>();
+    private Set<String> mMute = new HashSet<>();
+
+    public GameModeController(Context context) {
+        mContext = context;
+        mObserver = new SettingsObserver(new Handler(Looper.getMainLooper()));
+        mObserver.observe();
+    }
+
+    public void destroy() {
+        mContext.getContentResolver().unregisterContentObserver(mObserver);
+    }
+
+    private void ensureLoaded() {
+        if (!mLoaded) {
+            mObserver.update();
+        }
+    }
+
+    public boolean isGame(String packageName) {
+        ensureLoaded();
+        return packageName != null && mGames.contains(packageName);
+    }
+
+    public boolean shouldSuppressHeadsUp(String packageName) {
+        ensureLoaded();
+        return packageName != null && mSuppressHeadsUp.contains(packageName);
+    }
+
+    public boolean shouldMute(String packageName) {
+        ensureLoaded();
+        return packageName != null && mMute.contains(packageName);
+    }
+
+    /** Cheap guard so callers can skip resolving the foreground app when nothing is muted. */
+    public boolean hasMutedGames() {
+        ensureLoaded();
+        return !mMute.isEmpty();
+    }
+
+    /** Cheap guard so callers can skip resolving the foreground app when nothing is suppressed. */
+    public boolean hasSuppressedGames() {
+        ensureLoaded();
+        return !mSuppressHeadsUp.isEmpty();
+    }
+
+    // ANGLE selections live in Settings.Global because that is what GraphicsEnvironment reads
+    // when a process starts. Two parallel comma separated lists, package and driver.
+
+    private static final String ANGLE_DRIVER = "angle";
+
+    /** @return true when this package is explicitly pinned to the ANGLE GL driver. */
+    public boolean shouldUseAngle(String packageName) {
+        if (TextUtils.isEmpty(packageName)) {
+            return false;
+        }
+        return ANGLE_DRIVER.equals(readAngleSelections().get(packageName));
+    }
+
+    /**
+     * Pins the package to the ANGLE GL driver, or drops our entry again. Entries the user set
+     * through Developer options are preserved either way.
+     *
+     * <p>GraphicsEnvironment reads the selection when a process starts, so the app has to be
+     * restarted before the change takes effect.
+     */
+    public void setUseAngle(String packageName, boolean enabled) {
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+        final Map<String, String> selections = readAngleSelections();
+        final boolean pinnedToAngle = ANGLE_DRIVER.equals(selections.get(packageName));
+        if (enabled == pinnedToAngle) {
+            return;
+        }
+        if (enabled) {
+            selections.put(packageName, ANGLE_DRIVER);
+        } else {
+            selections.remove(packageName);
+        }
+        Settings.Global.putString(mContext.getContentResolver(),
+                Settings.Global.ANGLE_GL_DRIVER_SELECTION_PKGS,
+                TextUtils.join(",", selections.keySet()));
+        Settings.Global.putString(mContext.getContentResolver(),
+                Settings.Global.ANGLE_GL_DRIVER_SELECTION_VALUES,
+                TextUtils.join(",", selections.values()));
+    }
+
+    private Map<String, String> readAngleSelections() {
+        final List<String> packages = split(
+                Settings.Global.getString(mContext.getContentResolver(),
+                        Settings.Global.ANGLE_GL_DRIVER_SELECTION_PKGS));
+        final List<String> drivers = split(
+                Settings.Global.getString(mContext.getContentResolver(),
+                        Settings.Global.ANGLE_GL_DRIVER_SELECTION_VALUES));
+        final Map<String, String> selections = new LinkedHashMap<>();
+        final int count = Math.min(packages.size(), drivers.size());
+        for (int i = 0; i < count; i++) {
+            selections.put(packages.get(i), drivers.get(i));
+        }
+        return selections;
+    }
+
+    private static List<String> split(String value) {
+        final List<String> result = new ArrayList<>();
+        if (TextUtils.isEmpty(value)) {
+            return result;
+        }
+        for (String part : value.split(",")) {
+            final String trimmed = part.trim();
+            if (!trimmed.isEmpty()) {
+                result.add(trimmed);
+            }
+        }
+        return result;
+    }
+
+    public Set<String> getGames() {
+        return new HashSet<>(mGames);
+    }
+
+    public void addGame(String packageName) {
+        if (TextUtils.isEmpty(packageName) || !mGames.add(packageName)) {
+            return;
+        }
+        // Marking a package as a game turns both notification tweaks on by default.
+        mSuppressHeadsUp.add(packageName);
+        mMute.add(packageName);
+        writeGames();
+        writeSuppressHeadsUp();
+        writeMute();
+    }
+
+    public void removeGame(String packageName) {
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+        final boolean changed = mGames.remove(packageName);
+        mSuppressHeadsUp.remove(packageName);
+        mMute.remove(packageName);
+        if (changed) {
+            writeGames();
+            writeSuppressHeadsUp();
+            writeMute();
+            // Dropping a game also drops the ANGLE pin, but not a driver the user picked
+            // manually through Developer options.
+            setUseAngle(packageName, false);
+        }
+    }
+
+    public void setSuppressHeadsUp(String packageName, boolean enabled) {
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+        if (enabled ? mSuppressHeadsUp.add(packageName) : mSuppressHeadsUp.remove(packageName)) {
+            writeSuppressHeadsUp();
+        }
+    }
+
+    public void setMute(String packageName, boolean enabled) {
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+        if (enabled ? mMute.add(packageName) : mMute.remove(packageName)) {
+            writeMute();
+        }
+    }
+
+    private void writeGames() {
+        Settings.Secure.putString(mContext.getContentResolver(),
+                Settings.Secure.GAME_MODE_PACKAGES, TextUtils.join(",", mGames));
+    }
+
+    private void writeSuppressHeadsUp() {
+        Settings.Secure.putString(mContext.getContentResolver(),
+                Settings.Secure.GAME_MODE_SUPPRESS_HEADS_UP, TextUtils.join(",", mSuppressHeadsUp));
+    }
+
+    private void writeMute() {
+        Settings.Secure.putString(mContext.getContentResolver(),
+                Settings.Secure.GAME_MODE_MUTE, TextUtils.join(",", mMute));
+    }
+
+    private static Set<String> parse(String value) {
+        return new HashSet<>(split(value));
+    }
+
+    private Set<String> read(String key) {
+        return parse(Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                key, UserHandle.USER_CURRENT));
+    }
+
+    class SettingsObserver extends ContentObserver {
+        SettingsObserver(Handler handler) {
+            super(handler);
+        }
+
+        void observe() {
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(Settings.Secure.GAME_MODE_PACKAGES),
+                    false, this, UserHandle.USER_ALL);
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(Settings.Secure.GAME_MODE_SUPPRESS_HEADS_UP),
+                    false, this, UserHandle.USER_ALL);
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(Settings.Secure.GAME_MODE_MUTE),
+                    false, this, UserHandle.USER_ALL);
+            update();
+        }
+
+        @Override
+        public void onChange(boolean selfChange) {
+            update();
+        }
+
+        void update() {
+            try {
+                mGames = read(Settings.Secure.GAME_MODE_PACKAGES);
+                mSuppressHeadsUp = read(Settings.Secure.GAME_MODE_SUPPRESS_HEADS_UP);
+                mMute = read(Settings.Secure.GAME_MODE_MUTE);
+                mLoaded = true;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Could not read the game mode lists yet", e);
+            }
+        }
+    }
+}
