+package com.android.systemui.statusbar.notification.interruption
+
+import android.app.ActivityManager.RunningTaskInfo
+import android.app.IActivityTaskManager
+import android.app.TaskStackListener
+import android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN
+import android.content.Context.ACTIVITY_TASK_SERVICE
+import android.os.ServiceManager
+import android.util.Log
+
+/**
+ * Caches the package of the task currently in front.
+ *
+ * The heads-up decision runs on the main thread for every notification, so asking the activity
+ * task manager for the top task each time costs a synchronous binder round trip. Tracking task
+ * changes instead keeps the read to a volatile field access.
+ */
+class GameModeForegroundTracker : TaskStackListener() {
+
+    @Volatile private var foregroundPackage: String? = null
+    private var registered = false
+
+    /** @return package of the task that most recently moved to front, or null when unknown. */
+    fun getForegroundPackage(): String? {
+        ensureRegistered()
+        return foregroundPackage
+    }
+
+    @Synchronized
+    private fun ensureRegistered() {
+        if (registered) {
+            return
+        }
+        val activityTaskManager =
+            IActivityTaskManager.Stub.asInterface(
+                ServiceManager.getService(ACTIVITY_TASK_SERVICE)
+            ) ?: return
+        runCatching { activityTaskManager.registerTaskStackListener(this) }
+            .onSuccess { registered = true }
+            .onFailure { Log.w(TAG, "Could not register the task stack listener", it) }
+    }
+
+    override fun onTaskMovedToFront(taskInfo: RunningTaskInfo?) {
+        // Only a fullscreen task counts as "the user is playing". Split screen and freeform
+        // leave the cache empty so notifications are handled normally.
+        val isFullscreen = taskInfo?.windowingMode == WINDOWING_MODE_FULLSCREEN
+        foregroundPackage = if (isFullscreen) taskInfo?.topActivity?.packageName else null
+    }
+
+    companion object {
+        private const val TAG = "GameModeForegroundTracker"
+    }
+}
