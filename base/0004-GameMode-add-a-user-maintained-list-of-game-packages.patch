+
+package com.android.server.notification;
+
+import android.annotation.Nullable;
+import android.app.ActivityManager.RunningTaskInfo;
+import android.app.ActivityTaskManager;
+import android.app.IActivityTaskManager;
+import android.app.WindowConfiguration;
+import android.app.TaskStackListener;
+import android.content.ComponentName;
+import android.os.RemoteException;
+import android.util.Slog;
+
+/**
+ * Caches the package of the task currently in front.
+ *
+ * <p>NotificationManagerService needs to know whether the user is inside a game while it holds
+ * its own lock. Querying ActivityTaskManagerInternal there would take the window manager global
+ * lock while the notification lock is held, which opens a lock ordering inversion with anything
+ * that calls back into the notification service under that lock. Listening to task changes keeps
+ * the read lock free.
+ */
+final class GameModeForegroundTracker extends TaskStackListener {
+
+    private static final String TAG = "GameModeForegroundTracker";
+
+    @Nullable private volatile String mForegroundPackage;
+    private volatile boolean mRegistered;
+
+    GameModeForegroundTracker() {
+        ensureRegistered();
+    }
+
+    /**
+     * @return package of the task that most recently moved to front, or null when unknown.
+     */
+    @Nullable
+    String getForegroundPackage() {
+        ensureRegistered();
+        return mForegroundPackage;
+    }
+
+    // The activity task manager may not be published yet when the notification service is
+    // created, so registration is retried until it succeeds.
+    private synchronized void ensureRegistered() {
+        if (mRegistered) {
+            return;
+        }
+        final IActivityTaskManager atm = ActivityTaskManager.getService();
+        if (atm == null) {
+            return;
+        }
+        try {
+            atm.registerTaskStackListener(this);
+            mRegistered = true;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Could not register the task stack listener", e);
+        }
+    }
+
+    @Override
+    public void onTaskMovedToFront(RunningTaskInfo taskInfo) throws RemoteException {
+        // Only a fullscreen task counts as "the user is playing". Split screen and freeform
+        // leave the cache empty so notifications are handled normally.
+        final boolean isFullscreen =
+                taskInfo != null
+                        && taskInfo.getWindowingMode()
+                                == WindowConfiguration.WINDOWING_MODE_FULLSCREEN;
+        final ComponentName topActivity = taskInfo != null ? taskInfo.topActivity : null;
+        mForegroundPackage =
+                (isFullscreen && topActivity != null) ? topActivity.getPackageName() : null;
+    }
+}
