+/**
+ * Suppresses heads-up notifications while a game the user marked as quiet is on screen.
+ *
+ * The package list and the per app preference are maintained from Settings and stored in
+ * [android.provider.Settings.Secure], so they can also be edited with
+ * `adb shell settings put secure game_mode_suppress_heads_up "com.foo,com.bar"`.
+ */
+class PeekGameModeSuppressor(context: Context) :
+    VisualInterruptionCondition(types = setOf(PEEK), reason = "game mode is active") {
+
+    private val gameModeController = GameModeController(context)
+    private val foregroundTracker = GameModeForegroundTracker()
+
+    override fun start() {
+        // Start tracking before the first notification arrives, otherwise the very first
+        // heads-up has no cached answer and always interrupts.
+        foregroundTracker.getForegroundPackage()
+    }
+
+    override fun shouldSuppress(): Boolean {
+        if (!gameModeController.hasSuppressedGames()) return false
+        return gameModeController.shouldSuppressHeadsUp(foregroundTracker.getForegroundPackage())
+    }
+}
