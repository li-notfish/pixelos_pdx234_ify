 final class GameClassifierImpl implements GameClassifier {
 
     private final PackageManager mPackageManager;
+    private final GameModeController mGameModeController;
 
     GameClassifierImpl(@NonNull PackageManager packageManager) {
+        this(packageManager, null);
+    }
+
+    GameClassifierImpl(@NonNull PackageManager packageManager,
+            @Nullable GameModeController gameModeController) {
         mPackageManager = packageManager;
+        mGameModeController = gameModeController;
     }
 
     @Override
     public boolean isGame(@NonNull String packageName, @NonNull UserHandle userHandle) {
-        @ApplicationInfo.Category
-        int applicationCategory = ApplicationInfo.CATEGORY_UNDEFINED;
+        // A package the user explicitly marked as a game always wins, no matter what
+        // it declares in its manifest. Most sideloaded games and emulators declare nothing.
+        if (mGameModeController != null && mGameModeController.isGame(packageName)) {
+            return true;
+        }
 
+        final ApplicationInfo info;
         try {
-            applicationCategory =
-                    mPackageManager.getApplicationInfoAsUser(
-                            packageName,
-                            0,
-                            userHandle.getIdentifier()).category;
+            info = mPackageManager.getApplicationInfoAsUser(
+                    packageName, 0, userHandle.getIdentifier());
         } catch (PackageManager.NameNotFoundException ex) {
             return false;
         }
 
-        return applicationCategory == ApplicationInfo.CATEGORY_GAME;
+        // android:isGame="true" and android:appCategory="game" land in different fields,
+        // honor both so games that only set the legacy attribute are classified correctly.
+        return (info.flags & ApplicationInfo.FLAG_IS_GAME) != 0
+                || info.category == ApplicationInfo.CATEGORY_GAME;
     }
 }
