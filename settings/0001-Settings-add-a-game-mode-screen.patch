+package com.android.settings.game
+
+import android.app.AlertDialog
+import android.app.settings.SettingsEnums
+import android.os.Bundle
+import com.android.internal.util.GameModeController
+import com.android.settings.R
+import com.android.settings.core.BaseAppListSettingsFragment
+import com.android.settings.core.SubSettingLauncher
+
+/**
+ * Lets the user pick which packages are games. Tapping an app opens [GameAppSettings] where its
+ * game mode, notification and renderer behaviour is configured; long pressing one removes it
+ * from the list again.
+ */
+class GameModeSettings : BaseAppListSettingsFragment() {
+
+    private lateinit var gameModeController: GameModeController
+
+    // Toggling a game must not kill it, the user may be configuring while playing.
+    override val restartPackageOnChange = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        gameModeController = GameModeController(requireContext())
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // Coming back from the per game screen, the membership may have changed.
+        refreshAppList()
+    }
+
+    override fun onDestroy() {
+        gameModeController.destroy()
+        super.onDestroy()
+    }
+
+    override fun getTitleResId() = R.string.game_mode_settings_title
+
+    override fun getInitialCheckedList() = gameModeController.games.toList()
+
+    // Tapping opens the per game screen instead of toggling the entry.
+    override fun onItemClick(packageName: String): Boolean {
+        SubSettingLauncher(requireContext())
+            .setDestination(GameAppSettings::class.java.name)
+            .setArguments(GameAppSettings.arguments(packageName))
+            .setTitleText(appLabel(packageName))
+            .setSourceMetricsCategory(SettingsEnums.MANAGE_APPLICATIONS)
+            .launch()
+        return true
+    }
+
+    // Selection is driven by the per game screen, so the base toggle is unused here.
+    override fun onListUpdate(packageName: String, isChecked: Boolean) {}
+
+    override fun onItemLongClick(packageName: String): Boolean {
+        if (!gameModeController.isGame(packageName)) return false
+        AlertDialog.Builder(requireContext())
+            .setTitle(getString(R.string.game_mode_remove_title, appLabel(packageName)))
+            .setMessage(R.string.game_mode_remove_message)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                gameModeController.removeGame(packageName)
+                refreshAppList()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+        return true
+    }
+
+    private fun appLabel(packageName: String): CharSequence =
+        runCatching {
+                val pm = requireContext().packageManager
+                pm.getApplicationLabel(pm.getApplicationInfo(packageName, 0))
+            }
+            .getOrDefault(packageName)
+
+    companion object {
+        private const val TAG = "GameModeSettings"
+    }
+}
