+/**
+ * Per game screen: app name at the top, one toggle per behaviour, and a save / back bar.
+ *
+ * Nothing is written until the user hits save, so backing out leaves the game untouched.
+ */
+class GameAppSettings : Fragment(R.layout.game_mode_app_settings) {
+
+    private lateinit var gameModeController: GameModeController
+    private lateinit var packageName: String
+
+    private lateinit var modeGroup: MaterialButtonToggleGroup
+    private lateinit var switchSuppress: MaterialSwitch
+    private lateinit var switchMute: MaterialSwitch
+    private lateinit var switchAngle: MaterialSwitch
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        packageName = requireArguments().getString(ARG_PACKAGE).orEmpty()
+        gameModeController = GameModeController(requireContext())
+    }
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+
+        if (packageName.isEmpty()) {
+            close()
+            return
+        }
+
+        bindHeader(view)
+
+        bindGameMode(view)
+
+        switchSuppress = view.findViewById(R.id.switch_suppress)
+        switchMute = view.findViewById(R.id.switch_mute)
+        switchAngle = view.findViewById(R.id.switch_angle)
+
+        switchSuppress.isChecked = gameModeController.shouldSuppressHeadsUp(packageName)
+        switchMute.isChecked = gameModeController.shouldMute(packageName)
+        switchAngle.isChecked = gameModeController.shouldUseAngle(packageName)
+
+        // Tapping anywhere on a row flips its switch.
+        view.findViewById<View>(R.id.row_suppress).setOnClickListener { switchSuppress.toggle() }
+        view.findViewById<View>(R.id.row_mute).setOnClickListener { switchMute.toggle() }
+        view.findViewById<View>(R.id.row_angle).setOnClickListener { switchAngle.toggle() }
+
+        view.findViewById<View>(R.id.button_save).setOnClickListener { save() }
+        view.findViewById<View>(R.id.button_back).setOnClickListener { close() }
+    }
+
+    private fun bindHeader(view: View) {
+        val pm = requireContext().packageManager
+        val icon = view.findViewById<ImageView>(R.id.app_icon)
+        val name = view.findViewById<TextView>(R.id.app_name)
+        view.findViewById<TextView>(R.id.app_package).text = packageName
+        runCatching {
+                val info = pm.getApplicationInfo(packageName, 0)
+                icon.setImageDrawable(pm.getApplicationIcon(info))
+                name.text = pm.getApplicationLabel(info)
+            }
+            .onFailure { name.text = packageName }
+    }
+
+    private fun bindGameMode(view: View) {
+        modeGroup = view.findViewById(R.id.mode_group)
+        val gameManager = requireContext().getSystemService(GameManager::class.java)
+        val mode = runCatching { gameManager?.getGameMode(packageName) }.getOrNull()
+        val checkedButton =
+            when (mode) {
+                GameManager.GAME_MODE_PERFORMANCE -> R.id.mode_performance
+                GameManager.GAME_MODE_BATTERY -> R.id.mode_battery
+                else -> R.id.mode_standard
+            }
+        modeGroup.check(checkedButton)
+    }
+
+    private fun selectedMode(): Int =
+        when (modeGroup.checkedButtonId) {
+            R.id.mode_performance -> GameManager.GAME_MODE_PERFORMANCE
+            R.id.mode_battery -> GameManager.GAME_MODE_BATTERY
+            else -> GameManager.GAME_MODE_STANDARD
+        }
+
+    /**
+     * Applies the selected game mode through the system game manager.
+     *
+     * The service supplies its own resolution scaling when the game declares no configuration of
+     * its own, so setting the mode is enough here.
+     *
+     * The service only accepts modes for packages it already knows as games, and it learns that
+     * from a content observer on our own list, so a freshly marked game needs a couple of
+     * retries before setGameMode() stops being a silent no-op.
+     */
+    private fun applyGameMode(mode: Int) {
+        val appContext = requireContext().applicationContext
+        val userId = UserHandle.myUserId()
+        val handler = Handler(Looper.getMainLooper())
+        var attempts = 0
+
+        val attempt =
+            object : Runnable {
+                override fun run() {
+                    runCatching {
+                            val service =
+                                IGameManagerService.Stub.asInterface(
+                                    ServiceManager.getService(Context.GAME_SERVICE)
+                                ) ?: return
+                            service.setGameMode(packageName, mode, userId)
+                        }
+                        .onFailure {
+                            Log.w(TAG, "Could not apply game mode $mode to $packageName", it)
+                        }
+
+                    val current =
+                        runCatching {
+                                appContext
+                                    .getSystemService(GameManager::class.java)
+                                    ?.getGameMode(packageName)
+                            }
+                            .getOrNull()
+                    if (current == mode) {
+                        return
+                    }
+                    if (++attempts < MAX_ATTEMPTS) {
+                        handler.postDelayed(this, RETRY_DELAY_MS)
+                    } else {
+                        Log.w(TAG, "Game mode $mode never stuck for $packageName")
+                    }
+                }
+            }
+        handler.post(attempt)
+    }
+
+    private fun save() {
+        // Saving marks the package as a game, the other settings describe its behaviour.
+        gameModeController.addGame(packageName)
+        gameModeController.setSuppressHeadsUp(packageName, switchSuppress.isChecked)
+        gameModeController.setMute(packageName, switchMute.isChecked)
+        gameModeController.setUseAngle(packageName, switchAngle.isChecked)
+        applyGameMode(selectedMode())
+        close()
+    }
+
+    override fun onDestroy() {
+        if (::gameModeController.isInitialized) {
+            gameModeController.destroy()
+        }
+        super.onDestroy()
+    }
+
+    private fun close() {
+        requireActivity().onBackPressedDispatcher.onBackPressed()
+    }
+
+    companion object {
+        private const val TAG = "GameAppSettings"
+
+        private const val MAX_ATTEMPTS = 5
+        private const val RETRY_DELAY_MS = 200L
+
+        const val ARG_PACKAGE = "package_name"
+
+        @JvmStatic
+        fun arguments(packageName: String) =
+            Bundle().apply { putString(ARG_PACKAGE, packageName) }
+    }
+}
