From f6afb93bfa315c23cdff1c38c6fb8c598feb01da Mon Sep 17 00:00:00 2001
From: onlyfish <linotfish@outlook.com>
Date: Wed, 4 Nov 2026 11:38:46 +0800
Subject: [PATCH 6/6] media: Sony DSEE codec client hooks

Notify the Sony PAL DSEE wrapper of the active audio decoder via
AudioSystem parameters (codec_client_uid/state/format/bitrate), and
call AudioFlinger::onAudioFlingerInitComplete() once the local
AudioFlinger exists so EffectDapController can start its property
watcher and query the DMS HAL.

Change-Id: I6d1a8f3c0b7e2d9a5c4f8e1b3a6d0c7f2e9b4a58
---
 media/audioserver/main_audioserver.cpp        |  1 +
 .../include/media/SonyDseeCodecClient.h       | 56 +++++++++++++++++++
 media/libstagefright/MediaCodec.cpp           | 19 +++++++
 3 files changed, 76 insertions(+)
 create mode 100644 media/libaudioclient/include/media/SonyDseeCodecClient.h

diff --git a/media/audioserver/main_audioserver.cpp b/media/audioserver/main_audioserver.cpp
index af91da1..49d91e7 100644
--- a/media/audioserver/main_audioserver.cpp
+++ b/media/audioserver/main_audioserver.cpp
@@ -102,6 +102,7 @@ int main(int argc __unused, char **argv __unused)
     SLOGI("%s: AudioFlinger created", __func__);
     SLOGW_IF(AudioSystem::setLocalAudioFlinger(af) != OK,
             "%s: AudioSystem already has an AudioFlinger instance!", __func__);
+    af->onAudioFlingerInitComplete();
     const auto aps = sp<AudioPolicyService>::make();
     af->initAudioPolicyLocal(aps);
     SLOGI("%s: AudioPolicy created", __func__);
diff --git a/media/libaudioclient/include/media/SonyDseeCodecClient.h b/media/libaudioclient/include/media/SonyDseeCodecClient.h
new file mode 100644
index 0000000..f77602f
--- /dev/null
+++ b/media/libaudioclient/include/media/SonyDseeCodecClient.h
@@ -0,0 +1,56 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Notify Sony PAL DSEE of the active audio codec client.
+ * PAL dsee_set_parameters reads:
+ *   codec_client_uid, codec_client_state, codec_format, codec_bitrate
+ */
+#pragma once
+
+#include <media/AudioParameter.h>
+#include <media/AudioSystem.h>
+#include <system/audio.h>
+#include <utils/Log.h>
+#include <strings.h>
+
+namespace android {
+
+inline audio_format_t sonyDseeMimeToFormat(const char* mime) {
+    if (mime == nullptr) {
+        return AUDIO_FORMAT_DEFAULT;
+    }
+    if (strcasecmp(mime, "audio/mpeg") == 0) return AUDIO_FORMAT_MP3;
+    if (strcasecmp(mime, "audio/mpeg-L1") == 0) return AUDIO_FORMAT_MP3;
+    if (strcasecmp(mime, "audio/mpeg-L2") == 0) return AUDIO_FORMAT_MP2;
+    if (strcasecmp(mime, "audio/mp4a-latm") == 0) return AUDIO_FORMAT_AAC;
+    if (strcasecmp(mime, "audio/aac") == 0) return AUDIO_FORMAT_AAC;
+    if (strcasecmp(mime, "audio/raw") == 0) return AUDIO_FORMAT_PCM_16_BIT;
+    if (strcasecmp(mime, "audio/flac") == 0) return AUDIO_FORMAT_FLAC;
+    if (strcasecmp(mime, "audio/vorbis") == 0) return AUDIO_FORMAT_VORBIS;
+    if (strcasecmp(mime, "audio/opus") == 0) return AUDIO_FORMAT_OPUS;
+    if (strcasecmp(mime, "audio/ac3") == 0) return AUDIO_FORMAT_AC3;
+    if (strcasecmp(mime, "audio/eac3") == 0) return AUDIO_FORMAT_E_AC3;
+    if (strcasecmp(mime, "audio/eac3-joc") == 0) return AUDIO_FORMAT_E_AC3_JOC;
+    if (strcasecmp(mime, "audio/ac4") == 0) return AUDIO_FORMAT_AC4;
+    if (strcasecmp(mime, "audio/alac") == 0) return AUDIO_FORMAT_ALAC;
+    if (strcasecmp(mime, "audio/amr") == 0) return AUDIO_FORMAT_AMR_NB;
+    if (strcasecmp(mime, "audio/amr-wb") == 0) return AUDIO_FORMAT_AMR_WB;
+    return AUDIO_FORMAT_DEFAULT;
+}
+
+inline void sonyDseeNotifyCodecClient(uid_t uid, const char* mime, int32_t bitrate, bool on) {
+    if (mime == nullptr || strncmp(mime, "audio/", 6) != 0) {
+        return;
+    }
+    const audio_format_t fmt = sonyDseeMimeToFormat(mime);
+    AudioParameter param;
+    param.addInt(String8("codec_client_uid"), static_cast<int>(uid));
+    param.addInt(String8("codec_client_state"), on ? 1 : 0);
+    param.addInt(String8("codec_format"), static_cast<int>(fmt));
+    param.addInt(String8("codec_bitrate"), bitrate > 0 ? bitrate : 0);
+    const status_t st = AudioSystem::setParameters(param.toString());
+    ALOGD("SonyDseeCodecClient uid=%u mime=%s fmt=0x%x br=%d on=%d st=%d",
+          static_cast<unsigned>(uid), mime, fmt, bitrate, on ? 1 : 0, st);
+}
+
+}  // namespace android
diff --git a/media/libstagefright/MediaCodec.cpp b/media/libstagefright/MediaCodec.cpp
index 09438ed..1591157 100644
--- a/media/libstagefright/MediaCodec.cpp
+++ b/media/libstagefright/MediaCodec.cpp
@@ -64,6 +64,7 @@
 #include <media/MediaCodecBuffer.h>
 #include <media/MediaCodecInfo.h>
 #include <media/MediaMetricsItem.h>
+#include <media/SonyDseeCodecClient.h>
 #include <media/MediaResource.h>
 #include <media/NdkMediaErrorPriv.h>
 #include <media/NdkMediaFormat.h>
@@ -454,6 +455,8 @@ struct MediaCodec::ResourceManagerServiceProxy :
         mImportance = importance;
     }
 
+    uid_t clientUid() const { return mUid; }
+
 private:
     // To get the binder interface to ResourceManagerService.
     void getService() {
@@ -4948,6 +4951,22 @@ void MediaCodec::onMessageReceived(const sp<AMessage> &msg) {
 
                     postPendingRepliesAndDeferredMessages("kWhatComponentConfigured");
 
+                    // Notify Sony PAL DSEE of active audio decoder (uses mInputFormat for decoders).
+                    if (!(mFlags & kFlagIsEncoder) && mDomain == DOMAIN_AUDIO &&
+                            interestingFormat != nullptr) {
+                        AString mime;
+                        if (interestingFormat->findString("mime", &mime) &&
+                                mime.startsWithIgnoreCase("audio/")) {
+                            int32_t bitrate = 0;
+                            interestingFormat->findInt32("bitrate", &bitrate);
+                            if (bitrate == 0) {
+                                interestingFormat->findInt32(KEY_BIT_RATE, &bitrate);
+                            }
+                            const uid_t uid = mResourceManagerProxy->clientUid();
+                            sonyDseeNotifyCodecClient(uid, mime.c_str(), bitrate, true);
+                        }
+                    }
+
                     // augment our media metrics info, now that we know more things
                     // such as what the codec extracted from any CSD passed in.
                     if (mMetricsHandle != 0) {
-- 
