From 9006562fce9bc03d269ed292c5a46c0df7f7610f Mon Sep 17 00:00:00 2001
From: onlyfish <linotfish@outlook.com>
Date: Sun, 15 Nov 2026 14:17:46 +0800
Subject: [PATCH] audioflinger: release the Sony DAP effect outside the chain
 lock

EffectChain::removeEffect() called EffectDapController::effectReleased()
while holding EffectChain_Mutex. effectReleased() takes the DAP controller
lock:

  EffectChain::removeEffect():      EffectChain_Mutex -> mLock
  onGlobalMixChainAttached():       mLock -> chain->numberOfEffects()

That is an ABBA lock order between the effect chain and the controller
introduced by the Sony DAP port. Record the removed effect and call
effectReleased() after the chain lock is dropped. The caller still holds
AudioFlinger_Mutex / ThreadBase_Mutex as before, so the callback remains
synchronous, and the local sp keeps the module alive after release_l().

Change-Id: I2b7d9f4a6c1e8d3b5a0f7c2e9d4b6a8f1c3e5d70
---
 services/audioflinger/Effects.cpp | 87 +++++++++++++++++--------------
 1 file changed, 48 insertions(+), 39 deletions(-)

diff --git a/services/audioflinger/Effects.cpp b/services/audioflinger/Effects.cpp
index a8452fe..3735906 100644
--- a/services/audioflinger/Effects.cpp
+++ b/services/audioflinger/Effects.cpp
@@ -2649,52 +2649,61 @@ ssize_t EffectChain::getInsertIndex_l(const effect_descriptor_t& desc) {
 size_t EffectChain::removeEffect(const sp<IAfEffectModule>& effect,
                                                  bool release)
 {
-    audio_utils::lock_guard _l(mutex());
-    size_t size = mEffects.size();
-    uint32_t type = effect->desc().flags & EFFECT_FLAG_TYPE_MASK;
+    // effectReleased() takes the DAP controller lock. It must not run inside the effect chain
+    // lock: onGlobalMixChainAttached() takes the controller lock and then queries this chain.
+    sp<IAfEffectModule> releasedEffect;
+    size_t remainingEffectCount;
+    {
+        audio_utils::lock_guard _l(mutex());
+        size_t size = mEffects.size();
+        uint32_t type = effect->desc().flags & EFFECT_FLAG_TYPE_MASK;
 
-    const bool hasThreadAttached = mEffectCallback->hasThreadAttached();
-    for (size_t i = 0; i < size; i++) {
-        if (effect == mEffects[i]) {
-            // calling stop here will remove pre-processing effect from the audio HAL.
-            // This is safe as we hold the EffectChain mutex which guarantees that we are not in
-            // the middle of a read from audio HAL
-            if (mEffects[i]->state() == EffectModule::ACTIVE ||
-                    mEffects[i]->state() == EffectModule::STOPPING) {
-                mEffects[i]->stop_l();
-            }
-            if (release) {
-                if (EffectDapController::instance() != nullptr) {
-                    EffectDapController::instance()->effectReleased(effect);
+        const bool hasThreadAttached = mEffectCallback->hasThreadAttached();
+        for (size_t i = 0; i < size; i++) {
+            if (effect == mEffects[i]) {
+                // calling stop here will remove pre-processing effect from the audio HAL.
+                // This is safe as we hold the EffectChain mutex which guarantees that we are not
+                // in the middle of a read from audio HAL
+                if (mEffects[i]->state() == EffectModule::ACTIVE ||
+                        mEffects[i]->state() == EffectModule::STOPPING) {
+                    mEffects[i]->stop_l();
                 }
-                mEffects[i]->release_l("EffectChain::removeEffect");
-            }
-            // Skip operation when no thread attached (could lead to sigfpe as framecount is 0...)
-            if (hasThreadAttached && type != EFFECT_FLAG_TYPE_AUXILIARY) {
-                if (i == size - 1 && i != 0) {
-                    mEffects[i - 1]->configure_l();
-                    mEffects[i - 1]->setOutBuffer(mOutBuffer);
-                    mEffects[i - 1]->updateAccessMode_l();      // reconfig if needed.
+                if (release) {
+                    releasedEffect = mEffects[i];
+                    mEffects[i]->release_l("EffectChain::removeEffect");
+                }
+                // Skip operation when no thread attached (could lead to sigfpe as framecount is 0...)
+                if (hasThreadAttached && type != EFFECT_FLAG_TYPE_AUXILIARY) {
+                    if (i == size - 1 && i != 0) {
+                        mEffects[i - 1]->configure_l();
+                        mEffects[i - 1]->setOutBuffer(mOutBuffer);
+                        mEffects[i - 1]->updateAccessMode_l();      // reconfig if needed.
+                    }
+                }
+                mEffects.erase(mEffects.begin() + i);
+
+                // make sure the input buffer configuration for the new first effect in the chain
+                // is updated if needed (can switch from HAL channel mask to mixer channel mask)
+                if (type != EFFECT_FLAG_TYPE_AUXILIARY // TODO(b/284522658) breaks for aux FX, why?
+                        && hasThreadAttached && i == 0 && size > 1) {
+                    mEffects[0]->configure_l();
+                    mEffects[0]->setInBuffer(mInBuffer);
+                    mEffects[0]->updateAccessMode_l();      // reconfig if needed.
                 }
-            }
-            mEffects.erase(mEffects.begin() + i);
-
-            // make sure the input buffer configuration for the new first effect in the chain
-            // is updated if needed (can switch from HAL channel mask to mixer channel mask)
-            if (type != EFFECT_FLAG_TYPE_AUXILIARY // TODO(b/284522658) breaks for aux FX, why?
-                    && hasThreadAttached && i == 0 && size > 1) {
-                mEffects[0]->configure_l();
-                mEffects[0]->setInBuffer(mInBuffer);
-                mEffects[0]->updateAccessMode_l();      // reconfig if needed.
-            }
 
-            ALOGV("removeEffect_l() effect %p, removed from chain %p at rank %zu", effect.get(),
-                    this, i);
-            break;
+                ALOGV("removeEffect_l() effect %p, removed from chain %p at rank %zu",
+                        effect.get(), this, i);
+                break;
+            }
         }
+        remainingEffectCount = mEffects.size();
+    }
+
+    if (release && releasedEffect != nullptr && EffectDapController::instance() != nullptr) {
+        EffectDapController::instance()->effectReleased(releasedEffect);
     }
 
-    return mEffects.size();
+    return remainingEffectCount;
 }
 
 // setDevices_l() must be called with IAfThreadBase::mutex() held
-- 
