+// ---------------------------------------------------------------------------
+// Sony HAL parameter worker
+//
+// The policy entry points that read or write Sony HAL state all run with
+// AudioPolicyService_Mutex held. A synchronous getParameters()/setParameters()
+// from there can block the binder thread that timed out (11 号), so queue the
+// HAL traffic onto a managerdefault-local worker instead.
+// ---------------------------------------------------------------------------
+
+enum class SonyTaskType {
+    Write,
+    Refresh,
+    ReassertPlayingPkg,
+};
+
+struct SonyTask {
+    SonyTaskType type;
+    AudioPolicyClientInterface* client = nullptr;
+    String8 params;        // Write
+    std::string key;       // Refresh
+    bool forced = false;   // Refresh
+};
+
+struct SonyWorkerState {
+    std::mutex mutex;
+    std::deque<SonyTask> tasks;
+    // Keys with a Refresh still queued after the most recent Write. Cleared on
+    // every Write so a stale pre-write refresh cannot suppress a post-write one.
+    std::set<std::string> pendingRefresh;
+    bool running = false;
+    bool reassertPending = false;
+    bool havePlayingPkg = false;
+    int playingPkgUid = 0;
+    std::string playingPkgName;
+};
+
+SonyWorkerState gSonyWorker;
+
+void sonyWorkerLoop();
+
+// Must be called with gSonyWorker.mutex held.
+void sonyPushTaskLocked(SonyTask&& task) {
+    gSonyWorker.tasks.push_back(std::move(task));
+    if (!gSonyWorker.running) {
+        gSonyWorker.running = true;
+        std::thread(sonyWorkerLoop).detach();
+    }
+}
+
+// Must be called with gSonyWorker.mutex held.
+void sonyQueueRefreshLocked(AudioPolicyClientInterface* client, const char* key, bool forced) {
+    if (!gSonyWorker.pendingRefresh.insert(key).second) {
+        return;
+    }
+    SonyTask task;
+    task.type = SonyTaskType::Refresh;
+    task.client = client;
+    task.key = key;
+    task.forced = forced;
+    sonyPushTaskLocked(std::move(task));
+}
+
+void sonyRefreshHalParam(AudioPolicyClientInterface* client, const std::string& key, bool forced) {
+    if (client == nullptr) {
+        return;
+    }
+    if (!forced) {
+        String8 unused;
+        bool stale = true;
+        sonyLookupHalCache(key.c_str(), &unused, &stale);
+        if (!stale) {
+            return;  // another refresh or a write-through already updated the entry
+        }
+    }
+    const String8 result = client->getParameters(AUDIO_IO_HANDLE_NONE, String8(key.c_str()));
+    if (result.length() == 0) {
+        ALOGV("%s: %s returned no value", __func__, key.c_str());
+        return;
+    }
+    bool changed = false;
+    {
+        std::lock_guard<std::mutex> lock(gHalCacheMutex);
+        HalCacheEntry& entry = gHalCache[key];
+        changed = entry.value != result;
+        entry.value = result;
+        entry.expireNs = halCacheNowNs() + kHalCacheTtlNs;
+    }
+    if (!changed) {
+        return;
+    }
+    ALOGI("%s: %s -> %s", __func__, key.c_str(), result.c_str());
+    // A HAL value derived from the playing package changed without a policy-side
+    // write to push it. Replay the last playing package so AudioFlinger schedules
+    // one more routing evaluation against the now fresh values.
+    std::lock_guard<std::mutex> lock(gSonyWorker.mutex);
+    if (!gSonyWorker.havePlayingPkg || gSonyWorker.reassertPending) {
+        return;
+    }
+    gSonyWorker.reassertPending = true;
+    SonyTask task;
+    task.type = SonyTaskType::ReassertPlayingPkg;
+    task.client = client;
+    sonyPushTaskLocked(std::move(task));
+}
+
+void sonyWorkerLoop() {
+    for (;;) {
+        SonyTask task;
+        bool havePlayingPkg = false;
+        int playingPkgUid = 0;
+        std::string playingPkgName;
+        {
+            std::lock_guard<std::mutex> lock(gSonyWorker.mutex);
+            if (gSonyWorker.tasks.empty()) {
+                gSonyWorker.running = false;
+                return;
+            }
+            task = std::move(gSonyWorker.tasks.front());
+            gSonyWorker.tasks.pop_front();
+            if (task.type == SonyTaskType::Refresh) {
+                gSonyWorker.pendingRefresh.erase(task.key);
+            } else if (task.type == SonyTaskType::ReassertPlayingPkg) {
+                gSonyWorker.reassertPending = false;
+                havePlayingPkg = gSonyWorker.havePlayingPkg;
+                playingPkgUid = gSonyWorker.playingPkgUid;
+                playingPkgName = gSonyWorker.playingPkgName;
+            }
+        }
+        switch (task.type) {
+        case SonyTaskType::Write:
+            ALOGD("%s: write %s", __func__, task.params.c_str());
+            task.client->setParameters(AUDIO_IO_HANDLE_NONE, task.params, 0);
+            break;
+        case SonyTaskType::Refresh:
+            sonyRefreshHalParam(task.client, task.key, task.forced);
+            break;
+        case SonyTaskType::ReassertPlayingPkg:
+            if (havePlayingPkg) {
+                AudioParameter param;
+                param.addInt(String8("playing_pkg_uid"), playingPkgUid);
+                if (!playingPkgName.empty()) {
+                    param.add(String8("playing_pkg_name"), String8(playingPkgName.c_str()));
+                }
+                ALOGI("%s: reassert playing_pkg uid=%d pkg=%s", __func__, playingPkgUid,
+                      playingPkgName.empty() ? "(unknown)" : playingPkgName.c_str());
+                task.client->setParameters(AUDIO_IO_HANDLE_NONE, param.toString(), 0);
+            }
+            break;
+        }
+    }
+}
+
 }  // namespace
 
+bool sonyGetHalParamCached(AudioPolicyClientInterface* client, const char* key, String8* out) {
+    if (client == nullptr || key == nullptr || out == nullptr) {
+        return false;
+    }
+    bool stale = true;
+    const bool found = sonyLookupHalCache(key, out, &stale);
+    if (!found) {
+        out->clear();
+    }
+    if (stale) {
+        // Stale-while-revalidate: hand the caller the previous value (or a miss)
+        // and refresh off the AudioPolicyService lock.
+        std::lock_guard<std::mutex> lock(gSonyWorker.mutex);
+        sonyQueueRefreshLocked(client, key, false);
+    }
+    return found;
+}
+
+bool sonyGetHalBoolCached(AudioPolicyClientInterface* client, const char* key, bool* out) {
+    String8 result;
+    if (out == nullptr || !sonyGetHalParamCached(client, key, &result) || result.length() == 0) {
+        return false;
+    }
+    return sonyParseHalBool(AudioParameter(result), key, out);
+}
+
+bool sonyGetHalIntCached(AudioPolicyClientInterface* client, const char* key, int* out) {
+    String8 result;
+    if (out == nullptr || !sonyGetHalParamCached(client, key, &result) || result.length() == 0) {
+        return false;
+    }
+    return AudioParameter(result).getInt(String8(key), *out) == NO_ERROR;
+}
+
+void sonyMarkHalCacheStale() {
+    // Keep the previous values: callers may still use them as a stale snapshot
+    // while the worker refreshes, but the next read must revalidate.
+    std::lock_guard<std::mutex> lock(gHalCacheMutex);
+    for (auto& item : gHalCache) {
+        item.second.expireNs = 0;
+    }
+}
+
+void sonyStoreHalCacheValue(const char* key, const String8& value) {
+    std::lock_guard<std::mutex> lock(gHalCacheMutex);
+    HalCacheEntry& entry = gHalCache[key];
+    entry.value = value;
+    entry.expireNs = halCacheNowNs() + kHalCacheTtlNs;
+}
+
+void sonyQueueHalParameterWrite(AudioPolicyClientInterface* client, const String8& keyValuePairs) {
+    if (client == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(gSonyWorker.mutex);
+    // Refreshes queued before this write describe the pre-write HAL state.
+    gSonyWorker.pendingRefresh.clear();
+    SonyTask task;
+    task.type = SonyTaskType::Write;
+    task.client = client;
+    task.params = keyValuePairs;
+    sonyPushTaskLocked(std::move(task));
+}
+
 bool sonyDolbyEnabled(AudioPolicyClientInterface* client) {
     bool enabled = false;
     if (sonyGetHalBool(client, "dle_ds_state", &enabled)) {
