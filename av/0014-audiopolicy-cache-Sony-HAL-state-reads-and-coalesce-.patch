+// Short-lived cache for HAL parameter reads. Values change only when the user
+// toggles an effect or the playing package changes, both of which are slower
+// than the TTL; explicit invalidation covers the paths we drive ourselves.
+constexpr nsecs_t kHalCacheTtlNs = 200 * 1000000LL;  // 200 ms
+
+struct HalCacheEntry {
+    String8 value;
+    nsecs_t expireNs = 0;
+};
+
+std::mutex gHalCacheMutex;
+std::map<std::string, HalCacheEntry> gHalCache;
+
+nsecs_t halCacheNowNs() {
+    return systemTime(CLOCK_MONOTONIC);
+}
+
 bool sonyParseHalBool(const AudioParameter& param, const char* key, bool* out) {
     int value = 0;
     if (param.getInt(String8(key), value) == NO_ERROR) {
@@ -34,22 +55,16 @@ bool sonyParseHalBool(const AudioParameter& param, const char* key, bool* out) {
 }
 
 bool sonyGetHalBool(AudioPolicyClientInterface* client, const char* key, bool* out) {
-    if (client == nullptr || key == nullptr || out == nullptr) {
-        return false;
-    }
