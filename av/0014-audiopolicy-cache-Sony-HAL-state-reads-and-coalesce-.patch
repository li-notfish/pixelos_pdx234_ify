     AudioParameter param(result);
@@ -76,6 +91,51 @@ bool sonySonyEffectWinsOverDolby(AudioPolicyClientInterface* client) {
 
 }  // namespace
 
+bool sonyGetHalParamCached(AudioPolicyClientInterface* client, const char* key, String8* out) {
+    if (client == nullptr || key == nullptr || out == nullptr) {
+        return false;
+    }
+    const nsecs_t now = halCacheNowNs();
+    {
+        std::lock_guard<std::mutex> lock(gHalCacheMutex);
+        const auto it = gHalCache.find(key);
+        if (it != gHalCache.end() && now < it->second.expireNs) {
+            *out = it->second.value;
+            return true;
+        }
+    }
+    const String8 result = client->getParameters(AUDIO_IO_HANDLE_NONE, String8(key));
+    {
+        std::lock_guard<std::mutex> lock(gHalCacheMutex);
+        HalCacheEntry& entry = gHalCache[key];
+        entry.value = result;
+        entry.expireNs = now + kHalCacheTtlNs;
+    }
+    *out = result;
+    return true;
+}
+
+bool sonyGetHalBoolCached(AudioPolicyClientInterface* client, const char* key, bool* out) {
+    String8 result;
+    if (out == nullptr || !sonyGetHalParamCached(client, key, &result) || result.length() == 0) {
+        return false;
+    }
+    return sonyParseHalBool(AudioParameter(result), key, out);
+}
+
+bool sonyGetHalIntCached(AudioPolicyClientInterface* client, const char* key, int* out) {
+    String8 result;
+    if (out == nullptr || !sonyGetHalParamCached(client, key, &result) || result.length() == 0) {
+        return false;
+    }
+    return AudioParameter(result).getInt(String8(key), *out) == NO_ERROR;
+}
+
+void sonyInvalidateHalCache() {
+    std::lock_guard<std::mutex> lock(gHalCacheMutex);
+    gHalCache.clear();
+}
