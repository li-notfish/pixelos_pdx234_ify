+        static std::mutex sLock;
+        static bool sValid = false;
+        static uid_t sUid = 0;
+        static audio_format_t sFormat = AUDIO_FORMAT_DEFAULT;
+        static int32_t sBitrate = -1;
+        static bool sOn = false;
+        std::lock_guard<std::mutex> lock(sLock);
+        if (sValid && sUid == uid && sFormat == fmt && sBitrate == clampedBitrate &&
+                sOn == on) {
+            return;
+        }
+        sValid = true;
+        sUid = uid;
+        sFormat = fmt;
+        sBitrate = clampedBitrate;
+        sOn = on;
+    }
     AudioParameter param;
     param.addInt(String8("codec_client_uid"), static_cast<int>(uid));
     param.addInt(String8("codec_client_state"), on ? 1 : 0);
     param.addInt(String8("codec_format"), static_cast<int>(fmt));
-    param.addInt(String8("codec_bitrate"), bitrate > 0 ? bitrate : 0);
+    param.addInt(String8("codec_bitrate"), clampedBitrate);
