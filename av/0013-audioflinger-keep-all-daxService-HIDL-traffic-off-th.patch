+void EffectDapController::startDmsWorker() {
+    std::lock_guard<std::mutex> lock(mDmsMutex);
+    if (mDmsWorkerRunning) {
+        return;
+    }
+    mDmsWorkerRunning = true;
+    mDmsThread = std::thread([this] { dmsWorkerLoop(); });
+}
+
+void EffectDapController::stopDmsWorker() {
+    {
+        std::lock_guard<std::mutex> lock(mDmsMutex);
+        if (!mDmsWorkerRunning) {
+            return;
+        }
+        mDmsWorkerRunning = false;
+    }
+    mDmsCond.notify_all();
+    if (mDmsThread.joinable()) {
+        mDmsThread.join();
+    }
+}
+
+void EffectDapController::requestDmsConnect(audio_session_t sessionId,
+                                            audio_io_handle_t ioHandle) {
+    {
+        std::lock_guard<std::mutex> lock(mDmsMutex);
+        mDmsRequest = DmsRequest::Connect;
+        mDmsRequestSession = sessionId;
+        mDmsRequestIo = ioHandle;
+        mDmsRetryCount = 0;
+    }
+    mDmsCond.notify_one();
+}
+
+void EffectDapController::requestDmsDisconnect() {
+    {
+        std::lock_guard<std::mutex> lock(mDmsMutex);
+        mDmsRequest = DmsRequest::Disconnect;
+        mDmsRetryCount = 0;
+    }
+    mDmsCond.notify_one();
+}
+
+void EffectDapController::onDmsServiceDied() {
+    ALOGW("%s: re-queueing DMS connection", __func__);
+    audio_session_t sessionId = AUDIO_SESSION_NONE;
+    audio_io_handle_t ioHandle = AUDIO_IO_HANDLE_NONE;
+    {
+        Mutex::Autolock _l(mLock);
+        if (mDapEffect == nullptr) {
+            return;
+        }
+        sessionId = mDapEffect->sessionId();
+        sp<IAfPlaybackThread> thread = mDapPlaybackThread.promote();
+        if (thread != nullptr) {
+            ioHandle = thread->id();
+        }
+    }
+    if (ioHandle == AUDIO_IO_HANDLE_NONE) {
+        return;
+    }
+    requestDmsConnect(sessionId, ioHandle);
+}
+
+void EffectDapController::dmsWorkerLoop() {
+    constexpr int kMaxRetries = 30;
+    std::unique_lock<std::mutex> lock(mDmsMutex);
+    while (mDmsWorkerRunning) {
+        mDmsCond.wait(lock, [this] {
+            return !mDmsWorkerRunning || mDmsRequest != DmsRequest::None;
+        });
+        if (!mDmsWorkerRunning) {
+            break;
+        }
+        const DmsRequest request = mDmsRequest;
+        const audio_session_t sessionId = mDmsRequestSession;
+        const audio_io_handle_t ioHandle = mDmsRequestIo;
+        mDmsRequest = DmsRequest::None;
+        lock.unlock();
+
+        bool retry = false;
+        if (mDmsClient != nullptr) {
+            if (request == DmsRequest::Connect) {
+                const status_t status = mDmsClient->connect(sessionId, ioHandle);
+                retry = (status != NO_ERROR);
+                if (retry) {
+                    ALOGW("%s: DMS connect failed: %d", __func__, status);
+                }
+            } else if (request == DmsRequest::Disconnect) {
+                mDmsClient->disconnect();
+            }
+        }
+
+        lock.lock();
+        if (retry && mDmsWorkerRunning && mDmsRequest == DmsRequest::None) {
+            if (++mDmsRetryCount > kMaxRetries) {
+                ALOGE("%s: giving up DMS reconnect after %d attempts", __func__, kMaxRetries);
+                mDmsRetryCount = 0;
+            } else {
+                // daxService may still be restarting: re-arm and back off.
+                mDmsRequest = DmsRequest::Connect;
+                mDmsRequestSession = sessionId;
+                mDmsRequestIo = ioHandle;
+                mDmsCond.wait_for(lock, std::chrono::seconds(1));
+            }
+        } else if (!retry) {
+            mDmsRetryCount = 0;
+        }
+    }
+}
