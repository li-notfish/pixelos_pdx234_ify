+    mPropWatchThreadValid = true;
 }
 
 void EffectDapController::stopPropertyWatcher() {
     mPropWatchRunning.store(false);
+    if (mPropWatchThreadValid) {
+        // __system_property_wait() blocks for at most 1s.
+        pthread_join(mPropWatchThread, nullptr);
+        mPropWatchThreadValid = false;
+    }
 }
 
